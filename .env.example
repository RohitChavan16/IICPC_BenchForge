# BenchForge Environment Variables Configuration
# Copy this file to .env and replace placeholder values with your actual secrets.

# ==========================================
# Core Infrastructure
# ==========================================
DATABASE_URL=postgres://postgres:password@postgres:5432/iicpc?sslmode=disable
REDIS_URL=redis:6379

# ==========================================
# Secrets (MUST BE CHANGED FOR PRODUCTION)
# ==========================================
JWT_SECRET=super_secret_jwt_key_that_should_be_long_and_random
WORKER_SECRET=super_secret_worker_key

# ==========================================
# Service URLs (Internal Routing)
# ==========================================
SUBMISSION_SERVICE_URL=http://submission-service:8083
BENCHMARK_SERVICE_URL=http://benchmark-service:8082
LEADERBOARD_SERVICE_URL=http://leaderboard-service:8084
TELEMETRY_SERVICE_URL=http://telemetry-service:8081
DEPLOYMENT_SERVICE_URL=http://deployment-service:8091
BOT_WORKER_URL=http://bot-worker:8085
EXCHANGE_URL=http://mock-exchange:9000

# ==========================================
# Application Specific Settings
# ==========================================
# api-gateway rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BURST=20
# submission-service / container-runner
SUBMISSION_UPLOAD_DIR=/data/submissions
UPLOAD_DIR=/data/submissions

# deployment-service
DEPLOY_PORT_START=30000
DEPLOY_PORT_END=31000
DEPLOY_NETWORK=iicpc_benchforge_default

# ==========================================
# Service Ports (Optional overrides)
# ==========================================
# API_GATEWAY_PORT=8080
# BENCHMARK_SERVICE_PORT=8082
# SUBMISSION_SERVICE_PORT=8083
# LEADERBOARD_SERVICE_PORT=8084
# TELEMETRY_SERVICE_PORT=8081
# DEPLOYMENT_SERVICE_PORT=8091